{
  "name": "ajan-ofisi",
  "private": true,
  "version": "1.1.0",
  "description": "Claude Code oturumlarını 3B bir ofiste canlı gösteren yerel uygulama",
  "type": "module",
  "workspaces": [
    "server",
    "web"
  ],
  "engines": {
    "node": ">=22"
  },
  "scripts": {
    "start": "concurrently -k -n sunucu,arayuz -c magenta,cyan \"npm:dev -w server\" \"npm:dev -w web\"",
    "demo": "node scripts/ortam.mjs AJAN_OFISI_DEMO=dolu -- npm start",
    "build:demo": "node scripts/ortam.mjs VITE_STATIC_DEMO=1 -- npm run build -w web -- --base=/agent-office/",
    "test": "vitest run",
    "typecheck": "tsc -p server --noEmit && tsc -p web --noEmit",
    "format": "prettier --write .",
    "check": "npm run typecheck && npm test",
    "screenshots": "node scripts/ekran-goruntuleri.mjs"
  },
  "devDependencies": {
    "@types/node": "^22.20.5",
    "concurrently": "^9.2.5",
    "prettier": "^3.10.1",
    "tsx": "^4.23.15",
    "typescript": "^5.9.3",
    "vitest": "^5.1.1"
  },
  "overrides": {
    "@types/three": "0.187.0"
  },
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "https://github.com/zinkxx/agent-office.git"
  },
  "homepage": "https://zinkxx.github.io/agent-office/"
}
